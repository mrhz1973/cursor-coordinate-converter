+// Encode the literal as XML-safe text without changing the shared XML writer.
+// Backslash is doubled; all C0 controls and forbidden XML 1.0 code points are
+// written as backslash-u plus four uppercase hex digits (UTF-16 code unit).
+// Escaping TAB/LF/CR also avoids XML line-ending normalization.
+function mgrsLiteralForExport(raw){
+  const slash = String.fromCharCode(92);
+  let out = "";
+  for (const c of String(raw)){
+    const cp = c.codePointAt(0);
+    if (c === slash) out += slash + slash;
+    else if (cp < 0x20 || (cp >= 0xD800 && cp <= 0xDFFF) || cp === 0xFFFE || cp === 0xFFFF)
