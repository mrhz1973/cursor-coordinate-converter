# GOI ORS gateway — nginx TLS terminator (Tailscale cert)
# Placeholders replaced at deploy: __TS_IP__  __TS_DOMAIN__
# Bind Tailscale IPv4 only. Not a generic proxy.

server {
    listen __TS_IP__:443 ssl;
    server_name __TS_DOMAIN__;
    server_tokens off;

    ssl_certificate     /etc/goi-ors/tls/fullchain.pem;
    ssl_certificate_key /etc/goi-ors/tls/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 64k;
    client_body_timeout 10s;
    keepalive_timeout 15s;

    # Default access log: method/URI/status only. Coordinates live in POST body, not URI.
    access_log /var/log/nginx/goi-ors-gateway.access.log;
    error_log  /var/log/nginx/goi-ors-gateway.error.log warn;

    location = /ors/status {
        limit_except GET OPTIONS { deny all; }
        proxy_pass http://127.0.0.1:8020;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header Authorization "";
        proxy_read_timeout 5s;
        proxy_send_timeout 5s;
    }

    location ~ ^/ors/v2/directions/(foot-hiking|foot-walking|cycling-mountain)/geojson$ {
        limit_except POST OPTIONS { deny all; }
        proxy_pass http://127.0.0.1:8020;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Authorization "";
        proxy_read_timeout 25s;
        proxy_send_timeout 10s;
    }

    location / {
        default_type application/json;
        return 404 '{"error":"not_found","error_category":"path"}';
    }
}
